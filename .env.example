# Copy to .env and fill in, or run start.bat which creates it for you.
# Never commit .env.

# At least 32 random characters. Signs every login token.
JWT_SECRET=
# At least 16 random characters. Lets the services call each other.
INTERNAL_API_KEY=
# The first Super Admin. Created once, on first start. Must change the password at first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
